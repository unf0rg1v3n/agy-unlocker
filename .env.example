# Пример конфигурации agy-unlocker.
# Скопируйте в .env и при необходимости раскомментируйте.
# Переменные окружения имеют приоритет над этим файлом.

# Явный путь к бинарнику CLI (если авто-поиск не справляется).
# Windows:
# AGY_CLI_PATH=C:\Users\you\AppData\Local\agy\bin\agy.exe
# Linux/macOS:
# AGY_CLI_PATH=/home/you/.local/bin/agy

# Явный путь к language_server IDE.
# Windows:
# AGY_LANGSERVER_PATH=C:\Users\you\AppData\Local\Programs\Antigravity\resources\bin\language_server.exe
# Linux:
# AGY_LANGSERVER_PATH=/opt/antigravity/resources/bin/language_server
# macOS:
# AGY_LANGSERVER_PATH=/Applications/Antigravity.app/Contents/Resources/bin/language_server

# Отвечать "да" на все вопросы (завершение процессов и т.п.) без запроса: true/false
# AGY_UNLOCKER_ASSUME_YES=false

# Не выполнять сетевую проверку внешнего IP в doctor: true/false
# AGY_UNLOCKER_NO_NET=false

# Явный адрес прокси (если авто-детект системного прокси не подходит).
# Используется командами run и proxy install.
# AGY_PROXY=http://127.0.0.1:10809
